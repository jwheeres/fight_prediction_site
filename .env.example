# Copy to .env and fill in. Never commit the real key.
ODDS_API_KEY=

# Shared secret guarding POST /api/scheduled/score-results. Must be set for the
# scoring endpoint to accept writes; the scheduled scorer sends the same value
# in the X-Scoring-Secret header. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SCORING_SECRET=

# Flask session signing key. Generate as above.
SECRET_KEY=

# Optional database for users / picks / leaderboard. WITHOUT this, data is kept
# in data/*.json (fine locally, but WIPED on every redeploy on an ephemeral
# host like Render). WITH it, data persists across redeploys. Use a free hosted
# Postgres (e.g. Neon) and paste its connection string here:
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# sqlite:///local.db also works for local testing.
DATABASE_URL=
